#!/usr/bin/env bash
# E.D.I.T.H. - the visual review surface Jarvis raises for the captain.
# Thin alias for the edith-axi CLI (our fork of lavish-axi), so fleet prose and
# scripts can call the surface by its Jarvis name; flags, subcommands, and
# behavior are edith-axi's own. The npm package also installs an `edith` bin
# directly, in which case this shim is a harmless pass-through on PATH order.
set -eu
command -v edith-axi >/dev/null 2>&1 || {
  echo "error: edith-axi is not on PATH; install the E.D.I.T.H. fork (npm install -g git+https://github.com/your-org/edith-axi.git && edith-axi setup hooks)" >&2
  exit 1
}
exec edith-axi "$@"
